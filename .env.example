# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DART OpenAPI (https://opendart.fss.or.kr)
DART_API_KEY=your-dart-api-key

# Naver 검색 API (https://developers.naver.com)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 공공데이터포털 (https://www.data.go.kr) — 금융위 주식/지수 시세
PUBLIC_DATA_API_KEY=your-public-data-api-key

# 한국은행 ECOS (https://ecos.bok.or.kr/api) — 환율
BOK_API_KEY=your-bok-api-key

# Bybit Affiliate API (https://affiliates.bybit.com) — affiliate 권한 키
BYBIT_AFFILIATE_API_KEY=your-bybit-affiliate-api-key
BYBIT_AFFILIATE_API_SECRET=your-bybit-affiliate-api-secret

# 프론트엔드 URL (CORS 허용 origin)
FRONTEND_URL=https://kstockhelper.com

# 한 주기당 Claude classification 호출 상한 (기본 10)
MAX_CLASSIFY_PER_RUN=10

# Server
PORT=8080
