# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DART OpenAPI (https://opendart.fss.or.kr)
DART_API_KEY=your-dart-api-key

# Naver 검색 API (https://developers.naver.com)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 한국투자증권 KIS OpenAPI (https://apiportal.koreainvestment.com) — 주식/지수 현재가
# 실전계좌 앱키/시크릿. 환율은 ExchangeRate-API(키 불필요)를 사용하므로 별도 키 없음.
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret

# Bybit Affiliate API (https://affiliates.bybit.com) — affiliate 권한 키
BYBIT_AFFILIATE_API_KEY=your-bybit-affiliate-api-key
BYBIT_AFFILIATE_API_SECRET=your-bybit-affiliate-api-secret

# 관리자 페이지 JWT (자체 발급) — 랜덤 시크릿, 최소 32자 (예: openssl rand -hex 32)
JWT_SECRET=your-admin-jwt-secret
# /internal/admin/* 호출용 공유 시크릿 — 프론트 서버만 보유, 최소 32자 (예: openssl rand -hex 32)
# 프론트(서버 사이드)가 x-internal-secret 헤더로 이 값을 전송해야 admin API 진입 가능.
INTERNAL_API_SECRET=your-internal-api-secret
# 관리자 토큰 만료 (기본 8h). jsonwebtoken expiresIn 형식: 8h, 30m, 1d 등
ADMIN_TOKEN_TTL=8h

# 프론트엔드 URL (CORS 허용 origin)
FRONTEND_URL=https://kstockhelper.com

# 한 주기당 Claude classification 호출 상한 (기본 10)
MAX_CLASSIFY_PER_RUN=10

# Feature flags — Claude 비용이 발생하는 수집 잡 on/off (기본 true)
# 로컬 개발 시 false로 두면 Claude 호출이 없어 비용이 발생하지 않음
ENABLE_DART=true
ENABLE_NAVER=true

# Server
PORT=8080
