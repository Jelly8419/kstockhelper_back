# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DART OpenAPI (https://opendart.fss.or.kr)
DART_API_KEY=your-dart-api-key

# Naver 검색 API (https://developers.naver.com)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 한국투자증권 KIS OpenAPI (https://apiportal.koreainvestment.com) — 주식/지수 현재가
# 실전계좌 앱키/시크릿. 환율은 ExchangeRate-API(키 불필요)를 사용하므로 별도 키 없음.
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret

# Bybit Affiliate API (https://affiliates.bybit.com) — affiliate 권한 키
BYBIT_AFFILIATE_API_KEY=your-bybit-affiliate-api-key
BYBIT_AFFILIATE_API_SECRET=your-bybit-affiliate-api-secret

# 관리자 페이지 JWT (자체 발급) — 랜덤 시크릿, 최소 32자 (예: openssl rand -hex 32)
JWT_SECRET=your-admin-jwt-secret
# /internal/admin/* 호출용 공유 시크릿 — 프론트 서버만 보유, 최소 32자 (예: openssl rand -hex 32)
# 프론트(서버 사이드)가 x-internal-secret 헤더로 이 값을 전송해야 admin API 진입 가능.
INTERNAL_API_SECRET=your-internal-api-secret
# 관리자 토큰 만료 (기본 8h). jsonwebtoken expiresIn 형식: 8h, 30m, 1d 등
ADMIN_TOKEN_TTL=8h

# 프론트엔드 URL (CORS 허용 origin)
FRONTEND_URL=https://kstockhelper.com

# 한 주기당 Claude classification 호출 상한 (기본 10)
MAX_CLASSIFY_PER_RUN=10

# Feature flags — Claude 비용이 발생하는 수집 잡 on/off (기본 true)
# 로컬 개발 시 false로 두면 Claude 호출이 없어 비용이 발생하지 않음
ENABLE_DART=true
ENABLE_NAVER=true

# ── PayPal 구독 결제 (제한국가 Premium) ──────────────────────────────────────
# 구독 기능 on/off (기본 true). false면 /api/subscription/* 라우트가 비활성화되고
# 아래 PayPal 키들이 없어도 서버가 기동된다(로컬 개발 편의).
ENABLE_SUBSCRIPTION=true
# PayPal 환경: sandbox | live (기본 sandbox). API base URL을 결정한다.
PAYPAL_MODE=sandbox
# PayPal REST 앱 자격증명 (https://developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Trial($1/1달)+Regular($4.9/월) 빌링 플랜 ID.
# 생성: PAYPAL_MODE=sandbox npx tsx scripts/createPaypalPlan.ts 실행 후 출력값 기록.
# sandbox/live는 서로 다른 plan id를 사용한다.
PAYPAL_PLAN_ID=your-paypal-plan-id
# Webhook 서명 검증용 Webhook ID (대시보드 → Webhooks에서 발급).
# 구독 endpoint: POST {백엔드}/api/subscription/webhook 를 PayPal에 등록.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# (선택) 결제 승인/취소 후 복귀할 프론트 URL. 미설정 시 FRONTEND_URL 기반 기본값 사용.
# SUBSCRIPTION_RETURN_URL=https://kstockhelper.com/subscription/success
# SUBSCRIPTION_CANCEL_URL=https://kstockhelper.com/subscription

# Server
PORT=8080
